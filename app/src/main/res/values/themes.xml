<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FlowerShop" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/rose_primary</item>
        <item name="colorPrimaryVariant">@color/rose_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/leaf_green</item>
        <item name="colorSecondaryVariant">@color/leaf_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/rose_primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.FlowerShop.Splash">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/rose_dark</item>
        <item name="android:navigationBarColor">@color/rose_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.FlowerShop.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/rose_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.FlowerShop.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">15dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
    </style>

    <style name="Widget.FlowerShop.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="TextAppearance.FlowerShop.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.FlowerShop.Section" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.FlowerShop.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/rose_primary</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
</resources>
