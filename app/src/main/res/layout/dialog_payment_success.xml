<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_success_circle"
        android:contentDescription="@string/payment_success"
        android:padding="18dp"
        android:src="@drawable/ic_check"
        app:tint="@color/success" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/payment_success"
        android:textColor="@color/ink"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/payment_success_hint"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/success_order_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:textColor="@color/leaf_green"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
